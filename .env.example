# Copy this file to .env only for local use.
# Do NOT commit .env to GitHub.
#
# If your scripts use environment variables directly, set these in your
# PowerShell session or use a tool such as python-dotenv.

NEO4J_URI=your_neo4j_uri
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database

FALKORDB_HOST=your_falkordb_host
FALKORDB_PORT=62100
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your_falkordb_password

COGNODB_URI=your_cognodb_uri
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_cognodb_password

POKEC_FILE=data/pokec_sample.tsv
